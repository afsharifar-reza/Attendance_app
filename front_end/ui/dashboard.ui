              <property name="styleSheet">
               <string notr="true">/* استایل پایه برای جدول */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 12px;
    gridline-color: #f0f0f0;
    outline: 0;
}

/* استایل آیتم‌های جدول */
QTableWidget::item {
    padding: 6px;
    border-bottom: 1px solid #f0f0f0;
}

/* استایل آیتم‌های انتخاب شده */
QTableWidget::item:selected {
    background-color: #4a90e2;
    color: #ffffff;
}

/* استایل هدرهای جدول */
QHeaderView::section {
    background-color: #f8f9fa;
    color: #495057;
    padding: 8px;
    border: none;
    font-weight: 500;
    text-align: left;
}

/* افکت hover روی هدرها */
QHeaderView::section:hover {
    background-color: #e9ecef;
}

/* استایل گوشه جدول (محل تقاطع هدرهای عمودی و افقی) */
QTableCornerButton::section {
    background-color: #f8f9fa;
    border: none;
}

/* استایل اسکرول بار عمودی */
QScrollBar:vertical {
    border: none;
    background: #f8f9fa;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #ced4da;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

/* استایل اسکرول بار افقی (در صورت نیاز) */
QScrollBar:horizontal {
    border: none;
    background: #f8f9fa;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #ced4da;
    min-width: 20px;
    border-radius: 5px;
}</string>
