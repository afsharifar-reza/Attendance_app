                   <property name="styleSheet">
                    <string notr="true">QComboBox {
    /* تنظیمات فونت */
    font-family: &quot;B Nazanin&quot;, &quot;Segoe UI&quot;, Arial;
    font-size: 13px;
    color: #495057;
    
    /* تنظیمات ظاهری */
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 4px;
  
    min-width: 200px;
    min-height: 30px;
    
    /* تراز متن برای فارسی - راه حل اصلی */
    text-align: right;
    direction: rtl;
}

/* راهکار جایگزین برای تراز متن */
QComboBox QAbstractItemView {
    text-align: right;
    direction: rtl;
}

/* عنصر متن داخل کامبوباکس */
QComboBox QLineEdit {
    text-align: right;
    padding-right: 5px;
    direction: rtl;
}</string>
