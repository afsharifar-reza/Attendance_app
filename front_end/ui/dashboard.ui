QComboBox QAbstractItemView {
    text-align: right;
    direction: rtl;
}

/* عنصر متن داخل کامبوباکس */
QComboBox QLineEdit {
    text-align: right;
    padding-right: 5px;
    direction: rtl;
}</string>
